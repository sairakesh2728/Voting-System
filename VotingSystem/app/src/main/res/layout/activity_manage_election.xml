<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/main_gradient">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarManage"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="Manage Schedule"
        app:titleTextColor="@color/white"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="@color/white"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvElectionNameManage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Election Name"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/toolbarManage"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="24dp"
        android:layout_marginTop="20dp"/>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        android:layout_margin="24dp"
        app:layout_constraintTop_toBottomOf="@id/tvElectionNameManage">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Start Time (24h format)"
                android:textSize="16sp"
                android:textColor="#555555"/>

            <Button
                android:id="@+id/btnManageStartTime"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Set Start Time"
                android:textAlignment="viewStart"
                android:textSize="18sp"
                android:textAllCaps="false"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#DDDDDD"
                android:layout_marginVertical="10dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="End Time (24h format)"
                android:textSize="16sp"
                android:textColor="#555555"/>

            <Button
                android:id="@+id/btnManageEndTime"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Set End Time"
                android:textAlignment="viewStart"
                android:textSize="18sp"
                android:textAllCaps="false"/>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <ProgressBar
        android:id="@+id/pbSavingSchedule"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:indeterminateTint="@color/white"
        app:layout_constraintBottom_toTopOf="@id/btnSaveSchedule"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="20dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveSchedule"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:text="SAVE SCHEDULE"
        android:textSize="18sp"
        android:textStyle="bold"
        app:cornerRadius="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:backgroundTint="@color/white"
        android:layout_margin="24dp"
        android:textColor="#0F2027" />

</androidx.constraintlayout.widget.ConstraintLayout>
